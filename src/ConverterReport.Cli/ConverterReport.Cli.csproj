<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ConverterReportCli</AssemblyName>
    <RootNamespace>ConverterReport.Cli</RootNamespace>
    <Version>2.0.0</Version>
    <Product>ConverterReport</Product>
    <Description>Сборка суточного отчета ГГЭ в один PDF по данным файлов «Экран»</Description>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ConverterReport.Core\ConverterReport.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\ConverterReport.sample.json" Link="ConverterReport.sample.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\Справочно.sample.txt" Link="Справочно.sample.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
